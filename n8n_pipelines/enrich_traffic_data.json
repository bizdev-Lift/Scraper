      "id": "1bd71ef3-0084-4524-b326-1e334ed2f9b7",
      "name": "Extract Data from RapidAPI-SimilarWebAPI",
      "credentials": {
        "httpHeaderAuth": {
          "id": "lF6uX8wt0E5SReIv",
          "name": "RapidAPI-SimilarWebAPI-Traffic"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [\n    { \"filters\": [ {\n          \"propertyName\": \"traffic_enrichment_status_request\",\n          \"operator\": \"EQ\",\n          \"value\": \"requested\"\n        } ] }\n  ],\n  \"properties\": [\"name\", \"traffic_enrichment_status_request\", \"hubspot_owner_id\"],\n  \"limit\": 100\n}",
        "options": {}
      },
      "id": "2c4e341a-ce5d-4fdd-8339-1e8a498d7495",
      "name": "Get domains for Traffic Enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -464,
        -128
      ],
      "credentials": {
        "hubspotAppToken": {
          "id": "oRlKNrMVGZZb7WGP",
          "name": "HubSpot Service Key account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const domainRegex = /^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$/;\nconst output = [];\n\nfor (const item of $input.all()) {\n  const results = item.json.results || [];\n\n  for (const company of results) {\n    const rawName = company.properties?.name || '';\n    const cleanDomain = rawName.trim().toLowerCase();\n\n    if (domainRegex.test(cleanDomain)) {\n      output.push({\n        \n          ...company, // Retains all original keys\n          domain: cleanDomain\n        }\n      );\n    }\n  }\n}\n\nreturn {\"results\": output};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        -128
      ],
