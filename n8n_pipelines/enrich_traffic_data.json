      "name": "Update HubSpot",
      "credentials": {
        "hubspotAppToken": {
          "id": "oRlKNrMVGZZb7WGP",
          "name": "HubSpot Service Key account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// $json contains the current item's data directly\nconst rawResponse = $json;\n\nconst monthlyVisits = rawResponse.EstimatedMonthlyVisits || {};\nconst visitKeys = Object.keys(monthlyVisits);\n\nconst latestKey = visitKeys.length > 0 \n  ? visitKeys.reduce((max, key) => (key > max ? key : max)) \n  : null;\n\nconst engagements = rawResponse.Engagments || rawResponse.Engagements || {};\nconst traffic = rawResponse.TrafficSources || {};\n// US Traffic% Extraction\nconst topCountries = rawResponse.TopCountryShares || [];\nconst usData = topCountries.find(c => c.CountryCode === 'US');\nconst usTrafficShare = usData ? usData.Value : null;\n\n// Current Date formatted as YYYY-MM-DD\nconst currentDate = new Date().toISOString().split('T')[0];\nreturn {\n  companyId: $(\"Split Out\").item.json.id,\n  payload: {\n    total_monthly_visits: latestKey ? monthlyVisits[latestKey] : null,\n    bounce_rate: engagements.BounceRate ? parseFloat(engagements.BounceRate) : null,\n    pages_per_visit: engagements.PagePerVisit ? parseFloat(engagements.PagePerVisit) : null,\n    time_on_site: engagements.TimeOnSite,\n    traffic_source_search_organic: traffic.SearchOrganic ?? null,\n    traffic_source_search_paid: traffic.SearchPaid ?? null,\n    traffic_source_direct: traffic.Direct ?? null,\n    traffic_source_referrals: traffic.Referrals ?? null,\n    usa_traffic: usTrafficShare,\n    traffic_enrichment_date: currentDate,\n    traffic_enrichment_status_request: \"completed\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -128
      ],
      "id": "c3ff1e95-df9c-42d8-805e-d758fcac6e68",
      "name": "Parse Item"
    },
